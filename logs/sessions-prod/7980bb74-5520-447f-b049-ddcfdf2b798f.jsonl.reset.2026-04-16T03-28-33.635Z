96 Apr  9 15:00 insurance-product-qa\ndrwxrwxrwx 1 node node 4096 Apr  3 14:51 km-operation-prod\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 mcporter\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 model-usage\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 nano-pdf\ndrwxrwxrwx 1 node node 4096 Apr  8 14:51 nickname-lobster-call\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 node-connect\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 notion\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 obsidian\ndrwxrwxrwx 1 node node 4096 Apr  1 15:20 official-doc-writer\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 openai-whisper\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 openai-whisper-api\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 openhue\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 oracle\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 ordercli\ndrwxrwxrwx 1 node node 4096 Mar 31 09:32 pdf\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 peekaboo\ndrwxrwxrwx 1 node node 4096 Mar 31 09:32 pptx\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 sag\ndrwxrwxrwx 1 node node 4096 Apr  3 09:55 self-improving-agent\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 session-logs\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 sherpa-onnx-tts\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 skill-creator\ndrwxr-xr-x 1 node node 4096 Mar 11 10:58 skill-vetter\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 slack\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 songsee\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 sonoscli\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 spotify-player\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 summarize\ndrwxr-xr-x 1 node node 4096 Mar 19 15:56 superdesign\ndrwxrwxrwx 1 node node 4096 Apr  9 18:12 tender-bid-inspect-skill\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 things-mac\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 tmux\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 trello\ndrwxrwxrwx 1 node node 4096 Apr 10 10:21 understand-image\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 video-frames\ndrwxr-xr-x 1 node node 4096 Apr  3 02:26 voice-call\ndrwxr-xr-x 1 node node 40